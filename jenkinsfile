pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh "docker build -t xignaltest ."
            }
            
        }
        stage('Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'd67f98ab-4e57-49c0-a4e1-bdc121d498a3', passwordVariable: 'DOCKER_HUB_PASSWORD', usernameVariable: 'DOCKER_HUB_USER')]) {
                    sh 'docker login -u="$DOCKER_HUB_USER" -p="$DOCKER_HUB_PASSWORD"'
                    sh 'docker push charlene04/xignaltest'
                }
            }
            
        }
    }

    post {
        success {
            echo "This job was successful"

        }
        failure {
            echo "This job was NOT successful"
        }
        always {
            echo "This job IS Done"
        }
    }

}