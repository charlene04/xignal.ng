pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh "docker build -t xignaltest ."
            }
            
        }
        stage('Push') {
            steps {
                sh "docker login -u ${DOCKER_HUB_USER} -p ${DOCKER_HUB_PASSWORD}"
                sh "docker push xignaltest ."
            }
            
        }
    }

    post {
        success {
            echo "This job was successful"

        }
        failure {
            echo "This job was NOT successful"
        }
        always {
            echo "This job IS Done"
        }
    }

}